{
  "sets": [
    {
      "id": "app",
      "format": "arb",
      "source": "lib/l10n/app_en.arb",
      "targets": "lib/l10n/app_*.arb",
      "allowIdentical": [
        "appName"
      ]
    },
    {
      "id": "android",
      "format": "android",
      "source": "res/values/strings.xml",
      "targets": "res/values-*/strings.xml"
    },
    {
      "id": "ios",
      "format": "apple-strings",
      "source": "Runner/en.lproj/Localizable.strings",
      "targets": "Runner/*.lproj/Localizable.strings"
    }
  ]
}
