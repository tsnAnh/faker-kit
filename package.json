{
  "name": "faker-kit",
  "version": "0.1.0",
  "private": true,
  "description": "faker-kit, a trust-ladder team kit for Claude Code, Codex, and Pi. Install in Pi with: pi install git:github.com/tsnAnh/faker-kit",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tsnAnh/faker-kit.git"
  },
  "pi": {
    "skills": [
      "./plugins/*/skills"
    ],
    "extensions": [
      "./plugins/trust-ladder/pi/team-kit.ts"
    ]
  },
  "scripts": {
    "sync": "node scripts/sync-upstream.mjs",
    "sync:check": "node scripts/sync-upstream.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test:packs": "bash scripts/test-packs.sh"
  },
  "engines": {
    "node": ">=22"
  }
}
