{
  "extraKnownMarketplaces": {
    "team-kit": {
      "source": {
        "source": "github",
        "repo": "tsnAnh/skills"
      }
    }
  },
  "enabledPlugins": {
    "trust-ladder@team-kit": true,
    "pstack@team-kit": true,
    "cursor-team-kit@team-kit": true,
    "thermos@team-kit": true,
    "continual-learning@team-kit": true,
    "cli-for-agent@team-kit": true,
    "agent-compatibility@team-kit": true,
    "advisor@team-kit": true,
    "teaching@team-kit": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}
