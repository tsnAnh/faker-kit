#!/usr/bin/env bun
// A stand-in for the Claude Code CLI in tests: `-p` (local headless) and `--cloud` (cloud session).
import { execFileSync } from "node:child_process";
import { appendFileSync, readFileSync, writeFileSync } from "node:fs";

const args = process.argv.slice(2);
const mode = process.env.FAKE_MODE ?? "ok";
if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, `${JSON.stringify({ bin: "claude", args, cwd: process.cwd() })}\n`);
const git = (...a: string[]) => execFileSync("git", a, { stdio: "pipe" }).toString().trim();
const handoff = (branch: string) => `## Status\nsuccess\n\n## Branch\n\`${branch}\`\n\n## What I did\n- wrote fake.txt\n\n## Verification\nunit-test-verified\n`;

if (args.includes("--cloud") && args.includes("-p")) {
  // Follow-up to a cloud session: the session answers with a new handoff commit.
  const text = args[args.indexOf("-p") + 1] ?? "";
  const branch = /git checkout -B ([^\s`]+)/.exec(text)?.[1];
  const nonce = /orchestrate-handoff ([0-9a-f]+)/.exec(text)?.[1];
  const origin = process.env.FAKE_ORIGIN;
  if (branch && nonce && origin) {
    const dir = execFileSync("mktemp", ["-d"]).toString().trim();
    execFileSync("git", ["clone", "-q", "--branch", branch, origin, dir], { stdio: "pipe" });
    execFileSync("git", ["-C", dir, "commit", "-q", "--allow-empty", "-m", `orchestrate-handoff ${nonce}\n\n${handoff(branch)}follow-up\n`], { stdio: "pipe" });
    execFileSync("git", ["-C", dir, "push", "-q", "origin", `HEAD:refs/heads/${branch}`], { stdio: "pipe" });
  }
  process.exit(0);
}

if (args[0] === "--cloud") {
  const prompt = args[1] ?? "";
  if (mode === "nosession") {
    console.error("not signed in");
    process.exit(1);
  }
  const branch = /git checkout -B ([^\s`]+)/.exec(prompt)?.[1] ?? "fake-branch";
  const nonce = /orchestrate-handoff ([0-9a-f]+)/.exec(prompt)?.[1] ?? "none";
  git("checkout", "-q", "-B", branch);
  writeFileSync("fake-cloud.txt", "from the cloud\n");
  git("add", "fake-cloud.txt");
  git("commit", "-q", "-m", "fake cloud work");
  const first = mode === "wrongnonce" ? "orchestrate-handoff 000000" : `orchestrate-handoff ${nonce}`;
  git("commit", "-q", "--allow-empty", "-m", `${first}\n\n${handoff(branch)}`);
  git("push", "-q", "--force", "origin", `HEAD:refs/heads/${branch}`);
  console.log("Created cloud session https://claude.ai/code/session_fake123");
  process.exit(0);
}

// -p: headless local run in the current worktree.
const prompt = readFileSync(0, "utf8");
const sessionId = args[args.indexOf("--session-id") + 1] ?? args[args.indexOf("--resume") + 1];
const emit = (o: unknown) => console.log(JSON.stringify(o));
emit({ type: "system", subtype: "init", session_id: sessionId });
if (mode === "hang") {
  await new Promise(r => setTimeout(r, 60_000));
}
if (mode === "crash") {
  console.error("segfault pretending");
  process.exit(3);
}
emit({ type: "assistant", message: { content: [{ type: "text", text: "working" }, { type: "tool_use", name: "Bash", id: "t1" }] } });
const branch = git("branch", "--show-current");
writeFileSync("fake.txt", `${prompt.length}\n`);
if (mode !== "nocommit") {
  git("add", "fake.txt");
  git("commit", "-q", "-m", "fake work");
}
if (mode !== "nopush" && mode !== "nocommit") git("push", "-q", "--force", "origin", `HEAD:refs/heads/${branch}`);
if (mode === "fail") {
  emit({ type: "result", subtype: "error_max_turns", is_error: true, result: "ran out of turns", session_id: sessionId });
  process.exit(1);
}
emit({ type: "result", subtype: "success", is_error: false, result: handoff(branch), session_id: sessionId });
